# Copy to .env and fill in. Never commit .env.
#
# Database — use the provider's main / app user (e.g. neondb_owner, postgres), NOT a
# migration-only role like "prisma_migration" (low connection limit; will fail on Vercel).
#
# Prisma Postgres: use the "prismaorm" / Accelerate URL (prisma+postgres://...) as
# DATABASE_URL so the app uses pooling (see lib/prisma.tsx + @prisma/extension-accelerate).
# The direct postgres:// URL to db.prisma.io exhausts connection slots on Next dev + many requests.
#
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
# (optional: keep a direct URL for scripts/CLI if you are not on prisma+postgres-only flow)
#
# DATABASE_URL=postgresql://...
#
# Auth (required)
AUTH_SECRET=
# One way to generate: openssl rand -base64 32
#
# Google OAuth (optional) — "Continue with Google" on /sign-in
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 2) Application type: Web application
# 3) Authorized JavaScript origins: http://localhost:3000  (and your production origin)
# 4) Authorized redirect URIs:
#    http://localhost:3000/api/auth/callback/google
#    https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# If deploy fails CSRF or host checks (e.g. Vercel), set on the host:
# AUTH_TRUST_HOST=true

# Email (required for email verification in production)
# Uses SMTP via nodemailer.
# If not set, the app will still work but will log verification links to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=
EMAIL_FROM="Shweta Foods <your-gmail@gmail.com>"

# Public app URL (required to generate correct verification links)
# Use your canonical production origin in production.
# NEXT_PUBLIC_SERVER_URL="https://yourdomain.com"
